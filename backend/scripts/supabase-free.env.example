# Copiar para backend/artifacts/supabase-free/destino.env (ignorado pelo Git).
# Não modificar backend/.env nem frontend/.env.local antes da restauração validada.
# Conexão Session pooler, porta 5432; percent-encode caracteres da senha na URL.
CAUSOR_TARGET_DATABASE_URL=
# URL https://<project-ref>.supabase.co correspondente à conexão acima.
CAUSOR_TARGET_SUPABASE_URL=
# Chave pública do projeto; não usar service_role/secret key no frontend.
CAUSOR_TARGET_SUPABASE_ANON_KEY=
# Somente se o novo projeto emitir tokens HS256; ES256 usa JWKS confiável.
CAUSOR_TARGET_SUPABASE_JWT_SECRET=
