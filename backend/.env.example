CAUSOR_DATABASE_URL=sqlite:///./causor_dev.db

# A geração de minuta (POST /intimacoes/{id}/draft) usa o Claude via API.
# O SDK Anthropic lê ANTHROPIC_API_KEY direto do ambiente (sem prefixo CAUSOR_),
# então exporte-a no shell antes de subir o uvicorn — nunca a comite.
# PowerShell:  $env:ANTHROPIC_API_KEY="sk-ant-..."
# Sem a chave, o endpoint responde 503 com mensagem clara (o gate humano segue intacto).

