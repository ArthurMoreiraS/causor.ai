# Copie para .env e preencha. O .env está no .gitignore — nunca comite segredos.

# --- Banco (SOR) ---
# Local (sem Postgres): SQLite
#   CAUSOR_DATABASE_URL=sqlite:///./causor_dev.db
# Produção: Supabase (use o driver +psycopg). Caracteres especiais na senha
# devem vir URL-encoded (ex.: '@' vira '%40'). Para migrations, a string do
# pooler em modo sessão (porta 5432) é a mais segura; a de transação (6543)
# também funciona.
CAUSOR_DATABASE_URL=postgresql+psycopg://postgres.<ref>:<senha-url-encoded>@aws-1-<region>.pooler.supabase.com:6543/postgres

# --- DataJud (CNJ) ---
# Chave PÚBLICA do CNJ, publicada na Wiki do DataJud (pode ser rotacionada).
# Cole APENAS a chave, sem o prefixo "APIKey " (o cliente já o adiciona).
# Sem ela, a captura roda mas não enriquece o processo (cai no Noop client).
CAUSOR_DATAJUD_API_KEY=

# Nota: o app carrega este .env no ambiente automaticamente no boot
# (load_dotenv em app/settings.py), então as vars sem prefixo CAUSOR_ abaixo
# (ANTHROPIC_API_KEY / GEMINI_API_KEY) chegam aos SDKs sem precisar exportar
# nada na mão. O prefixo CAUSOR_ continua sendo lido pelo pydantic-settings.

# --- Provider LLM (classificação + minuta) ---
# Classificação de intimação e redação de minuta passam por um provider plugável.
# Trocar de modelo no futuro é mudar estas vars, não código.
#   CAUSOR_LLM_PROVIDER: "gemini" (default) | "claude"
#   CAUSOR_GEMINI_MODEL: default "gemini-2.5-flash"
#   CAUSOR_CLAUDE_MODEL: default "claude-opus-4-8"
# O chat assistente (POST /chat) roda sempre no Gemini, independente desta var.
CAUSOR_LLM_PROVIDER=gemini
# CAUSOR_GEMINI_MODEL=gemini-2.5-flash
# CAUSOR_CLAUDE_MODEL=claude-opus-4-8

# --- Anthropic / Claude ---
# Necessária só quando CAUSOR_LLM_PROVIDER=claude. O SDK Anthropic lê esta var
# direto do ambiente (sem prefixo CAUSOR_). Sem a chave (ou sem créditos na
# conta), o /draft responde 503/erro claro; o fluxo e o gate humano seguem.
ANTHROPIC_API_KEY=

# --- Gemini ---
# Usada pelo provider padrão (classificação + minuta) e pelo chat assistente.
# Pegue a chave em https://aistudio.google.com/. O SDK google-genai lê esta var
# direto do ambiente (sem prefixo CAUSOR_).
# ATENÇÃO: o free tier do Gemini pode usar os dados para treino — use o tier
# pago (ou modelo com não-retenção) para dados reais de cliente (sigilo/LGPD).
GEMINI_API_KEY=

# --- DJEN/Comunica (intimações) ---
# API pública do PJe — NÃO precisa de chave. URL base já tem default no código.
# CAUSOR_DJEN_BASE_URL=https://comunicaapi.pje.jus.br/api/v1
