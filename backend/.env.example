# Copie para .env e preencha. O .env esta no .gitignore; nunca comite segredos.

# --- Banco (SOR) ---
# Local (sem Postgres):
#   CAUSOR_DATABASE_URL=sqlite:///./causor_dev.db
# Producao: Supabase (use o driver +psycopg). Caracteres especiais na senha
# devem vir URL-encoded (ex.: '@' vira '%40').
CAUSOR_DATABASE_URL=postgresql+psycopg://postgres.<ref>:<senha-url-encoded>@aws-1-<region>.pooler.supabase.com:6543/postgres

# --- DataJud (CNJ) ---
# Cole apenas a chave, sem o prefixo "APIKey " (o cliente ja adiciona).
CAUSOR_DATAJUD_API_KEY=

# --- Claude ---
# O app carrega este .env automaticamente no boot. O SDK Anthropic le
# ANTHROPIC_API_KEY direto do ambiente.
#
# Custo recomendado:
# - chat operacional: Haiku
# - classificacao de intimacao: Haiku
# - redacao de minuta: Sonnet
CAUSOR_CLAUDE_MODEL=claude-sonnet-4-6
CAUSOR_CLAUDE_CHAT_MODEL=claude-haiku-4-5
CAUSOR_CLAUDE_CLASSIFICATION_MODEL=claude-haiku-4-5
CAUSOR_CLAUDE_DRAFT_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# --- DJEN/Comunica (intimacoes) ---
# API publica do PJe; nao precisa de chave. URL base ja tem default no codigo.
# CAUSOR_DJEN_BASE_URL=https://comunicaapi.pje.jus.br/api/v1

# --- Captura agendada ---
CAUSOR_CAPTURE_RETRY_ATTEMPTS=3
CAUSOR_CAPTURE_RETRY_BACKOFF_SECONDS=2
# Jobs que permanecerem "running" acima deste limite sao marcados como failed
# na proxima execucao de capture-due.
CAUSOR_JOB_STALE_MINUTES=60

# --- Vault ---
# Localdev cria apenas uma referencia deterministica sem guardar segredo bruto.
# Producao no Supabase: habilite a extensao Vault e use "supabase" para gravar
# sessoes PJe/tokens de provedor em vault.create_secret().
CAUSOR_VAULT_PROVIDER=localdev
